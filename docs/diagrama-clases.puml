skinparam classFontSize 12
skinparam packageFontSize 14
skinparam linetype ortho
skinparam shadowing false
skinparam class {
  BackgroundColor #1a1a2e
  BorderColor #e94560
  FontColor #eaeaea
  ArrowColor #e94560
  AttributeFontColor #cccccc
  StereotypeFontColor #e94560
}
skinparam package {
  BackgroundColor #16213e
  BorderColor #0f3460
