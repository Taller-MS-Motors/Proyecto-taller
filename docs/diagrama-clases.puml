    + normalizarTelefono(tel: string): string
  }

  class FechaCitaUtil <<Utility>> {
    + ahoraTaller(): Date
    + hoyCR(): string
    + diasHastaCita(fecha: string): number
    + badgeProximidad(fecha: string): BadgeProximidad
  }

  class WebVitalsUtil <<Utility>> {
    + iniciarWebVitals(): void
    - enviar(m: Metric): void
  }

  class SecureStoreUtil <<Utility>> {
    + secureGet(key: string): Promise<string>
    + secureSet(key: string, value: string): Promise<void>
    + secureRemove(key: string): Promise<void>
  }

  class TurnstileUtil <<Utility>> {
    + turnstileHabilitado(): boolean
    + montarTurnstile(container: HTMLElement): Promise<string>
  }

}

WebVitalsUtil --> WebVital : envía
SecureStoreUtil <.. BiometriaService : guarda credenciales
TurnstileUtil <.. PortalRegistroPage : protege el alta

note right of Cliente
  El cliente puede tener
  foto de perfil y cover
  (fondo de perfil).
  Se registra desde el portal
  o lo crea recepción.
end note

note right of Orden
  Flujo: recepcion → diagnostico
  → esperando_aprobacion
  → esperando_repuestos
  → en_reparacion → lista_entrega
  → entregada
end note

note bottom of AuthService
  Login unificado: busca primero
  en usuarios (staff), luego en
  clientes (portal). Un solo
  endpoint para ambos.
  Los dos tokens NO son
  intercambiables: el de cliente
  lleva tipo:'cliente' y sin rol.
end note

note right of MensajeInterno
  Una sola tabla para los tres
  usos, según `tipo`:
  directo (1:1), sistema
  (asignaciones automáticas) y
  broadcast (aviso por rol).
  La foto no viaja en el listado:
  se pide por /mensaje/:id/foto
  y el cliente la cachea por id.
end note

note right of Configuracion
  Fila única (id = 1).
  `horarios` es JSON:
  [{dia:0..6, abre, cierra, activo}].
  Define el cupo que ven por igual
  el portal y el mostrador.
end note

note bottom of PrecargaPorRol
  Reemplaza a PreloadAllModules,
  que bajaba los 83 chunks a todo
  el mundo. Precarga solo lo del
  rol y 2 s después del arranque.
end note

@enduml
