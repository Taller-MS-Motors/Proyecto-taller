' ══════════════════════════════════════
' ENUMERACIONES
' ══════════════════════════════════════

enum EstadoCita {
  agendado
  en_revision
  en_mantenimiento
  listo
  entregado
  cancelado
}

enum EstadoOrden {
  recepcion
  diagnostico
  esperando_aprobacion
  esperando_repuestos
  en_reparacion
  lista_entrega
  entregada
  cancelada
}

enum EstadoGarantia {
  abierto
  en_revision
  aprobado
  rechazado
  resuelto
}

enum RolUsuario {
  admin
  recepcion
  tecnico
}

' Jerarquía: recepcion < tecnico < admin (middleware/roles.js).
' `requireRol` hereda hacia arriba; `soloRoles` exige pertenencia exacta, para los
' casos en que un rol intermedio NO debe tener un permiso de uno inferior (el técnico
' no gestiona la agenda, la recepción sí).

enum EtapaOrden {
  recepcion
  diagnostico
  esperando_aprobacion
  esperando_repuestos
  en_reparacion
  lista_entrega
}

enum PrioridadTarea {
  baja
  normal
  alta
  urgente
}

' ══════════════════════════════════════
' MODELOS (INTERFACES DE DATOS)
' ══════════════════════════════════════
'
' Cubren las 22 tablas de dominio. Quedan FUERA a propósito cuatro tablas de
' infraestructura, que no son entidades del negocio y solo agregarían ruido:
'   · password_reset_codes, login_codes, email_verify_codes — códigos de un solo uso,
'     con vencimiento; se crean y se borran dentro del propio flujo de acceso.
'   · orden_contadores — contador por año para numerar las OT (OT-YYYY-XXXX).

